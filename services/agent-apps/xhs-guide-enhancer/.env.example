LLM_API_KEY=your_llm_api_key
LLM_MODEL_ID=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

XHS_MAX_LOCATIONS=8
XHS_NOTES_PER_LOCATION=5
XHS_MAX_EVIDENCE_NOTES=20
XHS_CRAWL_CONCURRENCY=3

# Spider_XHS 默认从当前 XHS Service 的 vendor/Spider_XHS 加载。
# 只有使用其他源码目录时才覆盖：
# SPIDER_XHS_PATH=/absolute/path/to/Spider_XHS
# 登录方式：cookie / qrcode / phone。qrcode 和 phone 会在服务终端中交互登录。
XHS_LOGIN_TYPE=cookie
# 仅 cookie 登录方式必填；请填写包含 a1 和 web_session 的完整 Cookie。
XHS_COOKIES=your_complete_xhs_cookie
XHS_REQUEST_PROXIES_JSON=
