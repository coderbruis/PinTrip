# OpenAI-compatible LLM configuration used by LangChain
LLM_MODEL_ID=your-model-name
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://your-llm-provider.example/v1
LLM_TIMEOUT=60
LLM_MAX_RETRIES=1

# AMap Web Service configuration
AMAP_MAPS_API_KEY=your-amap-web-service-api-key

# PostgreSQL + pgvector RAG configuration
RAG_DATABASE_URL=postgresql://pintrip:pintrip@127.0.0.1:5433/pintrip
EMBEDDING_SERVICE_URL=http://127.0.0.1:8081
PINTRIP_INTERNAL_API_KEY=pintrip-local-internal-key
EMBEDDING_DIMENSIONS=512
RAG_RETRIEVAL_LIMIT=8
