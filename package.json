{
  "name": "Pintrip",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:web": "pnpm --filter @pintrip/web dev",
    "dev:admin": "pnpm --filter @pintrip/admin dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"apps/{admin,web}/**/*.{ts,tsx,js,css,json,html,mjs}\"",
    "format:check": "prettier --check \"apps/{admin,web}/**/*.{ts,tsx,js,css,json,html,mjs}\"",
    "dev:user-api": "cd services/user-api && mvn spring-boot:run",
    "dev:admin-api": "cd services/admin-api && mvn spring-boot:run",
    "dev:agent:import": "cd services/agent-apps/import-guide && python -m uvicorn app.main:app --reload --port 8090",
    "dev:agent:natural-language": "cd services/agent-apps/natural-language-guide && python -m uvicorn app.main:app --reload --port 8091"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.4.0",
    "typescript": "^5.8.0"
  }
}
